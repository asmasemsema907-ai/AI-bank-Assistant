# Copy this file to .env for local testing (never commit the real .env).
# No account or API key needed at all — Ollama runs locally.
# Install: https://ollama.com/download  then run: ollama pull llama3.1
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Keep false in production unless the server is allowed to download models
# from Hugging Face during setup. When false, the app uses locally cached
# transformer files or falls back to a local TF-IDF retriever.
ALLOW_MODEL_DOWNLOAD=false
